# ── Required ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
GH_PAT=ghp_...

# ── Optional — defaults shown ──────────────────────────────────
GITHUB_DEFAULT_REPO=owner/repo
CLAUDE_MODEL=claude-sonnet-4-5
WATCHDOG_MODEL=claude-sonnet-4-5
ENV=development

# ── Database ───────────────────────────────────────────────────
DB_PATH=data/agent.db

# ── Security (set in all networked deployments) ────────────────
# Generate: openssl rand -hex 32
API_KEY=
API_CORS_ORIGINS=http://localhost,http://localhost:8000

# ── Agent behaviour ────────────────────────────────────────────
MAX_STEPS=25
STEP_TIMEOUT_SECONDS=300
MAX_CONCURRENT_TASKS=1
MAX_TASK_USD=5.00
WATCHDOG_MAX_USD=2.00
ZOMBIE_REAPER_INTERVAL_SECONDS=60
DB_BACKUP_ENABLED=true
DB_BACKUP_INTERVAL_SECONDS=86400
DB_BACKUP_RETENTION_DAYS=14

# AGENT_WORKSPACE: set to a directory owned by the service user with mode 0700
# in production — must NOT be world-writable.
AGENT_WORKSPACE=/tmp/agent_workspace

# ── Playwright ─────────────────────────────────────────────────
PLAYWRIGHT_ENABLED=false
WHITELISTED_DOMAINS=github.com

# ── Logging ────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=false
