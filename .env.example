# ── Required ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
GH_PAT=ghp_...

# ── Optional — defaults shown ──────────────────────────────────
GITHUB_DEFAULT_REPO=owner/repo
CLAUDE_MODEL=claude-sonnet-4-5-20251101
WATCHDOG_MODEL=claude-sonnet-4-5-20251101
ENV=development

# ── Database ───────────────────────────────────────────────────
DB_PATH=data/agent.db

# ── Security (set in all networked deployments) ────────────────
# Generate: openssl rand -hex 32
API_KEY=
API_CORS_ORIGINS=http://localhost,http://localhost:8000

# PR-B1: Explicit unauthenticated mode (localhost dev only).
# Set INSECURE_LOCAL_AUTH=1 ONLY when API_KEY is empty and the server is
# reachable only on localhost.  NEVER set this in any networked deployment.
# Without this flag, empty API_KEY fails closed (all protected endpoints → 401).
# INSECURE_LOCAL_AUTH=1

# PR-B1: Short-lived SSE stream token TTL in seconds (default 120).
# POST /tasks/{id}/stream-token issues a token valid for this many seconds.
# STREAM_TOKEN_TTL_SECONDS=120

# ── Agent behaviour ────────────────────────────────────────────
MAX_STEPS=25
STEP_TIMEOUT_SECONDS=300
MAX_CONCURRENT_TASKS=1
TASK_CREATE_RATE_LIMIT_ENABLED=true
TASK_CREATE_RATE_LIMIT_COUNT=6
TASK_CREATE_RATE_LIMIT_WINDOW_SECONDS=60
TASK_REQUEST_MAX_BYTES=65536
MAX_TASK_USD=5.00
WATCHDOG_MAX_USD=2.00
DAILY_MAX_USD=20.00
ZOMBIE_REAPER_INTERVAL_SECONDS=60
DB_BACKUP_ENABLED=true
DB_BACKUP_INTERVAL_SECONDS=86400
DB_BACKUP_RETENTION_DAYS=14

# AGENT_WORKSPACE: set to a directory owned by the service user with mode 0700
# in production — must NOT be world-writable.
AGENT_WORKSPACE=/tmp/agent_workspace

# ── Playwright ─────────────────────────────────────────────────
PLAYWRIGHT_ENABLED=false
WHITELISTED_DOMAINS=github.com

# ── Logging ────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=false
